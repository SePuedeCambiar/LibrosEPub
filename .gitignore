# Dependencias Go
backend/vendor/

# ALMACENAMIENTO: No subir los libros descargados
# Ignora todo en downloads pero mantiene el .gitkeep
backend/storage/downloads/*
!backend/storage/downloads/.gitkeep

# Logs y variables de entorno
*.log
backend/.env

